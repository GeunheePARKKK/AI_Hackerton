# 이 파일을 `.env`로 복사하고 키를 채우면 AI 기능(자연어 명령/챗봇/분석)이 훨씬 빨라집니다.
# 키가 하나도 없으면 Claude Code CLI로 폴백합니다 (동작은 하지만 호출당 15~25초).
# 우선순위: GEMINI > GROQ > OPENAI > claude CLI

# 무료 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# 무료 발급: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# 유료: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
